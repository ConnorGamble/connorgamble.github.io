@inherits LayoutComponentBase
@inject SiteData Site

<a class="skip-link" href="#main">Skip to content</a>
<div class="backdrop" aria-hidden="true"></div>

<NavMenu />

<main id="main" class="container page">
    @Body
</main>

<footer class="site-footer">
    <div class="container site-footer__inner">
        <img class="site-footer__mascot" src="Tickle.png" alt="" width="40" height="40" />
        <p class="site-footer__text">@Site.Info.ShortName <span aria-hidden="true">&middot;</span> &copy; @DateTime.Now.Year</p>
        @if (!string.IsNullOrEmpty(Site.Info.GitHub))
        {
            <a class="icon-link" href="@Site.Info.GitHub" aria-label="GitHub">
                <Icon Name="Icon.Icons.GitHub" />
            </a>
        }
    </div>
</footer>
