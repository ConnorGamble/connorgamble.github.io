@inject SiteData Site

<header class="site-header" data-menu>
    <div class="container site-header__inner">
        <a class="brand" href="">
            <span class="brand__mark" aria-hidden="true"></span>
            @Site.Info.Title
        </a>

        <nav class="nav" aria-label="Main">
            @foreach (var item in MenuItems)
            {
                <NavLink class="nav__link" ActiveClass="is-active" Match="@(item.Link == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)" href="@item.Link">@item.Name</NavLink>
            }
        </nav>

        <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
            <Icon Name="Icon.Icons.Menu" Class="nav-toggle__open" />
            <Icon Name="Icon.Icons.Close" Class="nav-toggle__close" />
        </button>
    </div>

    <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile">
        @foreach (var (item, i) in MenuItems.Select((item, i) => (item, i)))
        {
            <NavLink class="mobile-menu__link" ActiveClass="is-active" style="@($"--i: {i}")" Match="@(item.Link == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)" href="@item.Link">@item.Name</NavLink>
        }
    </nav>
</header>

@code {
    // Home and Experience are fixed; everything else comes from sections marked `nav: true`.
    IEnumerable<MenuItem> MenuItems =>
        new[] { new MenuItem("Home", ""), new MenuItem("Experience", "experience") }
            .Concat(Site.NavSections.Select(s => new MenuItem(s.Name, s.Slug)));

    record MenuItem(string Name, string Link);
}
