@page "/experience"
@inject SiteData Site
@inject PageContentService Pages

@{
    var intro = Pages.Get("experience");
    var roles = Site.Experience.Roles;
}

<SiteHead Title="@intro?.FrontMatter.PageTitle" Description="@intro?.FrontMatter.Description" />

<PageHeader Intro="intro" Fallback="Experience" />

<ExperienceGroup Heading="Current Role" Entries="roles.Where(r => r.Current)" />
<ExperienceGroup Heading="Previous Roles" Entries="roles.Where(r => !r.Current)" />
<ExperienceGroup Heading="Education" Entries="Site.Experience.Education" />
