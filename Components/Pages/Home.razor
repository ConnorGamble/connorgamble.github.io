@page "/"
@inject SiteData Site
@inject PageContentService Pages

@{
    var intro = Pages.Get("home");
    var firstSection = Site.NavSections.FirstOrDefault();
}

<SiteHead Title="@intro?.FrontMatter.PageTitle" Description="@intro?.FrontMatter.Description" />

<section class="hero">
    <div class="hero__text">
        <h1 class="hero__title"><AccentText Text="@(intro?.FrontMatter.Title ?? Site.Info.Title)" Accent="@intro?.FrontMatter.Accent" /></h1>

        @if (intro is not null)
        {
            <div class="prose hero__intro">@((MarkupString)intro.Html)</div>
        }

        <div class="hero__actions">
            <a class="button" href="experience">See my experience <Icon Name="Icon.Icons.ArrowRight" /></a>
            @if (firstSection is not null)
            {
                <a class="button button--ghost" href="@firstSection.Slug">Browse @firstSection.Name.ToLowerInvariant()</a>
            }
        </div>
    </div>

    <aside class="profile-card reveal">
        <div class="avatar">
            <img src="@Site.Info.Avatar" alt="@Site.Info.AvatarAlt" width="160" height="160" />
        </div>
        <p class="profile-card__tagline">@Site.Info.Tagline</p>
        @if (!string.IsNullOrEmpty(Site.Info.GitHub))
        {
            <a class="profile-card__link" href="@Site.Info.GitHub">
                <Icon Name="Icon.Icons.GitHub" /> GitHub
            </a>
        }
    </aside>
</section>

@if (Site.Info.Skills.Count > 0)
{
    <section class="skills reveal">
        <h2 class="label">Core skillset</h2>
        <ul class="chips">
            @foreach (var (skill, i) in Site.Info.Skills.Select((skill, i) => (skill, i)))
            {
                <li class="chip chip--skill" style="--i: @i">@skill</li>
            }
        </ul>
    </section>
}
