@page "/projects"
@page "/projects/{fileName}"
@using System.Globalization
@using BlazorStatic
@using BlazorStatic.Services
@inject BlazorStaticContentService<BlogFrontMatter> blazorStaticContentService

<HeadContent>
    <title>Connor Gamble</title>
    <meta name="description" content="C# Developer and avid gamer" />
    <meta name="keywords" content="Connor Gamble" />
    <meta name="author" content="Connor Gamble" />
</HeadContent>


@* No filename -> show latest posts *@
@if (string.IsNullOrWhiteSpace(FileName))
{
    <div class="divide-y divide-gray-700">
        <div class="space-y-2 pb-8 pt-6 md:space-y-5">
            <h1 class="font-sans md:leading-14 text-3xl font-extrabold leading-9 tracking-tight text-gray-100 sm:text-4xl sm:leading-10 md:text-6xl">Software</h1>
            <p class="text-lg leading-7 text-gray-400 prose prose-invert">Some software projects I am (or have) worked on</p>
        </div>
        
        <PostsList PostType="Projects" />
    </div>

    <div class="divide-y divide-gray-700">
        <div class="space-y-2 pb-8 pt-6 md:space-y-5">
            <h1 class="font-sans md:leading-14 text-3xl font-extrabold leading-9 tracking-tight text-gray-100 sm:text-4xl sm:leading-10 md:text-6xl">Games</h1>
            <p class="text-lg leading-7 text-gray-400 prose-invert">Game prototype/vertical slices which I have worked on, mostly from University.</p>
        </div>

        <PostsList PostType="GamePortfolio" />
    </div>
    return;
}

@* Show specific post by filename param *@
@if (post == null)
{
    <div>Post not found 🤷</div>
    return;
}

<IndividualPost post="post" FileName="@FileName"></IndividualPost>

@code{
    [Parameter] public string? FileName { get; set; }
    Post<BlogFrontMatter>? post;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(FileName)) return;
        post = blazorStaticContentService.Posts.FirstOrDefault(x => x.Url == FileName);
    }
}
