@page "/tags"
@page "/tags/{TagName}"
@inject SiteData Site
@inject BlazorStaticContentService<PostFrontMatter> Content

@if (TagName is null)
{
    var tagsWithCount = Content.Posts
        .SelectMany(p => p.Tags)
        .Where(t => Site.FindSection(t.Name) is null)
        .GroupBy(t => t.Name)
        .Select(g => (Tag: g.First(), Count: g.Count()))
        .OrderByDescending(x => x.Count)
        .ThenBy(x => x.Tag.Name);

    <SiteHead />
    <PageHeader Fallback="Tags" />
    <ul class="chips chips--cloud">
        @foreach (var (tag, count) in tagsWithCount)
        {
            <li><a class="chip" href="@Content.Options.Tags.TagsPageUrl/@tag.EncodedName">@tag.Name <span class="chip__count">@count</span></a></li>
        }
    </ul>
    return;
}

@{
    var posts = Content.Posts
        .Where(p => p.Tags.Any(t => t.EncodedName == TagName || t.Name == TagName))
        .OrderByDescending(p => p.FrontMatter.Published)
        .ToList();
    var name = posts.SelectMany(p => p.Tags).FirstOrDefault(t => t.EncodedName == TagName || t.Name == TagName)?.Name ?? TagName;
}

<SiteHead />
<header class="page-header">
    <a class="back-link" href="@Content.Options.Tags.TagsPageUrl"><Icon Name="Icon.Icons.ArrowLeft" /> All tags</a>
    <h1 class="page-header__title"><span class="accent">#</span>@name</h1>
    <p class="page-header__sub">@posts.Count @(posts.Count == 1 ? "post" : "posts") tagged with @name</p>
</header>

<PostGrid Posts="posts" />

@code {
    [Parameter] public string? TagName { get; set; }
}
